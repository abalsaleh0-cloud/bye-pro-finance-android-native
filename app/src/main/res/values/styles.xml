<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="NativeFinanceTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/finance_dark_background</item>
        <item name="android:navigationBarColor">@color/finance_dark_background</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:colorAccent">@color/finance_light_accent</item>
        <item name="android:windowBackground">@color/finance_dark_background</item>
    </style>

    <style name="NativeFinanceCalendarLightTheme" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">@color/finance_light_accent</item>
        <item name="colorOnPrimary">@color/finance_light_background</item>
        <item name="colorSurface">@color/finance_light_surface</item>
        <item name="colorOnSurface">@color/finance_light_text</item>
        <item name="colorOnSurfaceVariant">@color/finance_light_secondary_text</item>
    </style>

    <style name="NativeFinanceCalendarDarkTheme" parent="ThemeOverlay.MaterialComponents.MaterialCalendar">
        <item name="colorPrimary">@color/finance_dark_accent</item>
        <item name="colorOnPrimary">@color/finance_dark_background</item>
        <item name="colorSurface">@color/finance_dark_surface</item>
        <item name="colorOnSurface">@color/finance_dark_text</item>
        <item name="colorOnSurfaceVariant">@color/finance_dark_secondary_text</item>
    </style>

    <style name="NativeFinanceDialogLightTheme" parent="@android:style/Theme.Material.Light.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@drawable/finance_dialog_background_light</item>
        <item name="android:colorAccent">@color/finance_light_accent</item>
        <item name="android:textColorPrimary">@color/finance_light_text</item>
        <item name="android:textColorSecondary">@color/finance_light_secondary_text</item>
        <item name="android:windowMinWidthMajor">87%</item>
        <item name="android:windowMinWidthMinor">87%</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/NativeFinanceDialogActionButtonLight</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/NativeFinanceDialogActionButtonLight</item>
    </style>

    <style name="NativeFinanceDialogDarkTheme" parent="@android:style/Theme.Material.Dialog.Alert">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@drawable/finance_dialog_background_dark</item>
        <item name="android:colorAccent">@color/finance_dark_accent</item>
        <item name="android:textColorPrimary">@color/finance_dark_text</item>
        <item name="android:textColorSecondary">@color/finance_dark_secondary_text</item>
        <item name="android:windowMinWidthMajor">87%</item>
        <item name="android:windowMinWidthMinor">87%</item>
        <item name="android:buttonBarPositiveButtonStyle">@style/NativeFinanceDialogActionButtonDark</item>
        <item name="android:buttonBarNegativeButtonStyle">@style/NativeFinanceDialogActionButtonDark</item>
    </style>

    <style name="NativeFinanceDialogActionButtonLight" parent="@android:style/Widget.Material.Light.Button.Borderless.Colored">
        <item name="android:minHeight">@dimen/finance_button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="NativeFinanceDialogActionButtonDark" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:minHeight">@dimen/finance_button_height</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="NativeFinancePopupLightTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/finance_light_accent</item>
        <item name="android:colorBackground">@color/finance_light_surface</item>
        <item name="android:textColorPrimary">@color/finance_dark_background</item>
        <item name="android:textColorSecondary">@color/finance_light_secondary_text</item>
    </style>

    <style name="NativeFinancePopupDarkTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/finance_dark_accent</item>
        <item name="android:colorBackground">@color/finance_dark_surface</item>
        <item name="android:textColorPrimary">@color/finance_dark_text</item>
        <item name="android:textColorSecondary">@color/finance_dark_secondary_text</item>
    </style>
</resources>
